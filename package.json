{
  "name": "@sudobility/svgr_lib",
  "version": "0.0.64",
  "description": "Shared business logic library for SVGR web and React Native apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "lint:fix": "bunx eslint src --ext .ts,.tsx --fix",
    "format": "bunx prettier --write src/**/*.ts",
    "format:check": "bunx prettier --check src/**/*.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "keywords": [
    "svgr",
    "svg",
    "converter",
    "business-logic",
    "react",
    "typescript"
  ],
  "author": "John Huang",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/svgr_client": "^1.0.59",
    "@sudobility/svgr_types": "^1.0.36",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/svgr_client": "^1.0.59",
    "@sudobility/svgr_types": "^1.0.36",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "~5.104.5",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/svgr_lib.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
